# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Backend Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Windows Local Agent Configuration
AGENT_HOST=127.0.0.1
AGENT_PORT=8001
AGENT_ID=local-windows-agent-01
AGENT_SECRET_KEY=change-this-to-a-secure-random-token

# AI Provider Configuration (Optional - Defaults to local deterministic / rule engine)
AI_PROVIDER=mock
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Music Provider Configuration (youtube by default, or spotify)
MUSIC_PROVIDER=youtube

# Spotify Developer API (OAuth 2.0 Web API optional)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/v1/spotify/callback
SPOTIFY_ACCESS_TOKEN=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_DEFAULT_DEVICE_ID=

