{
  "name": "jarvis-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "productName": "JARVIS",
  "description": "JARVIS Autonomous AI Personal Assistant for Windows",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:dev": "electron . --dev",
    "package:win": "electron-packager . JARVIS --platform=win32 --arch=x64 --out=release-builds --icon=desktop/assets/icon.ico --overwrite --prune=false --download.cacheRoot=\"%LOCALAPPDATA%\\electron\\Cache\" --ignore=\"^(tests|jarvis-backend/venv|jarvis-backend/\\.pytest_cache|release-builds|\\.git|jarvis-backend/app/ai/data/command_learning_dataset\\.jsonl)\"",
    "desktop:build": "npm run build && npm run package:win",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.7.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
