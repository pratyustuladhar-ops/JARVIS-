# JARVIS AI Operating System - Environment Configuration
APP_NAME="JARVIS Autonomous AI Agent Backend"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/jarvis
# If PostgreSQL is not yet running, set this to sqlite:///./jarvis_local.db for standalone development
# DATABASE_URL=sqlite:///./jarvis.db

# Frontend CORS
FRONTEND_URL=http://localhost:5173
ADDITIONAL_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:5500","http://localhost:8000"]

# AI/ML Agent Brain Configuration
AI_PROVIDER=mock
AI_MODEL=cognition-llm-4.2
AI_API_KEY=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048
INTENT_CONFIDENCE_THRESHOLD=0.65

# Music Provider Configuration (youtube by default, or spotify)
MUSIC_PROVIDER=youtube

# Spotify Music Service Configuration (OAuth 2.0 optional)
SPOTIFY_ENABLED=True
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/v1/spotify/callback
SPOTIFY_ACCESS_TOKEN=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_DEFAULT_DEVICE_ID=

# Host & Port
HOST=127.0.0.1
PORT=8000

